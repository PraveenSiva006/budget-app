{
  "compilerOptions": {
    /* Project references */
    "composite": true,

    /* Output */
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,

    /* Structure */
    "rootDir": "src",
    "outDir": "dist",

    /* Safety */
    "stripInternal": true
  },
  "include": ["src"],
  /* Language */
  "target": "ES2023",

  /* Type System */
  "strict": true,

  /* Interop & Safety */
  "esModuleInterop": true,
  "forceConsistentCasingInFileNames": true,
  "isolatedModules": true,

  /* Performance */
  "skipLibCheck": true
}
