generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CASH
  BANK
  CREDIT_CARD
  WALLET
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  monthlyBudget Budget[]
}

model Account {
  id             String      @id @default(uuid())
  userId         String
  name           String
  type           AccountType
  accountNumber  String?
  currency       String      @default("INR")
  openingBalance Decimal     @db.Decimal(14, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  outgoingTransactions Transaction[] @relation("TransactionFromAccount")
  incomingTransactions Transaction[] @relation("TransactionToAccount")

  @@unique([userId, name])
  @@index([userId])
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetCategoryLimits BudgetCategoryLimit[]
  transactions         Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id            String          @id @default(uuid())
  userId        String
  fromAccountId String?
  toAccountId   String?
  categoryId    String?
  amount        Decimal         @db.Decimal(14, 2)
  type          TransactionType
  note          String?
  occurredAt    DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  fromAccount Account?  @relation("TransactionFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account?  @relation("TransactionToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
  @@index([fromAccountId])
  @@index([toAccountId])
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  month      Int
  year       Int
  totalLimit Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryLimits BudgetCategoryLimit[]

  @@unique([userId, month, year])
  @@index([userId])
}

model BudgetCategoryLimit {
  id              String   @id @default(uuid())
  monthlyBudgetId String
  categoryId      String
  limit           Decimal  @db.Decimal(14, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  monthlyBudget Budget @relation(fields: [monthlyBudgetId], references: [id], onDelete: Cascade)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([monthlyBudgetId, categoryId])
}
