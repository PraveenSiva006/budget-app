generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CASH
  BANK
  CREDIT_CARD
  WALLET
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  monthlyBudget MonthlyBudget[]
}

model Account {
  id        String      @id @default(uuid())
  userId    String
  name      String
  type      AccountType
  accNumber String?
  currency  String      @default("INR")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@unique([id, userId])
  @@unique([userId, name])
  @@index([userId])
}

model Category {
  id        String          @id @default(uuid())
  userId    String
  name      String
  type      TransactionType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user                 User                  @relation(fields: [userId], references: [id])
  transactions         Transaction[]
  budgetCategoryLimits BudgetCategoryLimit[]

  @@unique([id, userId])
  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id         String          @id @default(uuid())
  userId     String
  accountId  String
  categoryId String?
  amount     Decimal         @db.Decimal(14, 2)
  type       TransactionType
  note       String?
  occurredAt DateTime
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  account  Account   @relation(fields: [accountId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  @@unique([id, userId])
  @@index([userId, occurredAt])
  @@index([accountId])
  @@index([categoryId])
}

model MonthlyBudget {
  id         String   @id @default(uuid())
  userId     String
  month      Int
  year       Int
  totalLimit Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())

  user           User                  @relation(fields: [userId], references: [id])
  categoryLimits BudgetCategoryLimit[]

  @@unique([id, userId])
  @@unique([userId, month, year])
  @@index([userId])
}

model BudgetCategoryLimit {
  id              String  @id @default(uuid())
  monthlyBudgetId String
  categoryId      String
  limit           Decimal @db.Decimal(14, 2)

  monthlyBudget MonthlyBudget @relation(fields: [monthlyBudgetId], references: [id])
  category      Category      @relation(fields: [categoryId], references: [id])

  @@unique([monthlyBudgetId, categoryId])
}
