{
  "compilerOptions": {
    /* Language */
    "target": "ES2023",
    "ignoreDeprecations": "6.0",

    /* Type System */
    "strict": true,

    /* Interop & Safety */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,

    /* Performance */
    "skipLibCheck": true
  }
}
